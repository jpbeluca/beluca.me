# OpenAI API key — used server-side by /api/agent for the chat endpoint.
# Never expose to the client. Set in Vercel → Settings → Environment Variables
# for Preview and Production.
OPENAI_API_KEY=

# Slack Incoming Webhook URL — used server-side by /api/agent to transcribe
# every completed visitor conversation (in-scope, refusal, fallback) to a
# private Slack channel. MUST point at a private channel because the payload
# includes IP, User-Agent, and geolocation. If unset, the chat still works
# and Slack notifications are silently skipped.
SLACK_WEBHOOK_URL=
