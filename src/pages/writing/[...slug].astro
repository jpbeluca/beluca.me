---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateLabel = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
}).format(post.data.date);

const description = post.data.excerpt;
const ogImage = `/writing/${post.id}/og.png`;
---

<BaseLayout
  title={`${post.data.title} — John Beluca`}
  description={description}
  ogImage={ogImage}
  type="article"
>
  <span id="top"></span>
  <Header />

  <main>
    <article class="post">
      <a class="post__back" href="/writing/">← All writing</a>

      <div class="post__meta">
        <span class="post__tag">{post.data.tag}</span>
        <span class="post__date">{dateLabel} · {post.data.readTime}</span>
      </div>

      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__excerpt">{post.data.excerpt}</p>

      <hr class="post__rule" />

      <div class="post__body">
        <Content />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .post {
    max-width: 760px;
    margin: 0 auto;
    /*padding: 64px var(--page-pad-x) 96px;*/
  }

  .post__back {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 48px;
    transition: color 0.15s;
  }

  .post__back:hover {
    color: var(--accent);
  }

  .post__meta {
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .post__tag {
    color: var(--accent);
  }

  .post__title {
    font-family: var(--font-sans);
    font-size: 60px;
    font-weight: 400;
    letter-spacing: -1.5px;
    line-height: 1.05;
    margin: 0 0 24px;
    color: var(--ink);
  }

  .post__excerpt {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 21px;
    line-height: 1.5;
    color: var(--ink2);
    margin: 0 0 40px;
    max-width: 640px;
  }

  .post__rule {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 0 0 40px;
  }

  .post__body {
    font-family: var(--font-sans);
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink2);
  }

  .post__body :global(h2) {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.3px;
    color: var(--ink);
    margin: 56px 0 16px;
    line-height: 1.3;
  }

  .post__body :global(h3) {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
    margin: 40px 0 12px;
    line-height: 1.3;
  }

  .post__body :global(p) {
    margin: 0 0 22px;
    max-width: 720px;
  }

  .post__body :global(ul),
  .post__body :global(ol) {
    margin: 0 0 22px;
    padding-left: 24px;
    max-width: 720px;
  }

  .post__body :global(li) {
    margin-bottom: 10px;
  }

  .post__body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .post__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post__body :global(code) {
    font-family: var(--font-mono);
    font-size: 15px;
    background: var(--bg-alt);
    padding: 2px 6px;
    color: var(--ink);
  }

  .post__body :global(pre) {
    background: var(--bg-alt);
    padding: 18px 20px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 28px;
    border-left: 2px solid var(--accent);
  }

  .post__body :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }

  .post__body :global(blockquote) {
    margin: 0 0 28px;
    padding-left: 20px;
    border-left: 2px solid var(--accent);
    font-style: italic;
    color: var(--ink2);
  }

  @media (max-width: 820px) {
    .post {
      padding: 40px var(--page-pad-x) 64px;
    }
    .post__title {
      font-size: 38px;
      letter-spacing: -0.6px;
    }
    .post__excerpt {
      font-size: 18px;
    }
    .post__body {
      font-size: 17px;
    }
  }
</style>
