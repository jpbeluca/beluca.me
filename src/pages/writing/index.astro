---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/Footer.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
});

const entryCount = String(posts.length).padStart(2, "0");
const tags = Array.from(new Set(posts.map((p) => p.data.tag)));
---

<BaseLayout
  title="Writing — John Beluca"
  description="Notes on AI systems, agentic architectures, AWS, and the slower work of leading engineering."
>
  <main>
    <div class="page__topnav">
      <a href="/">← beluca.me</a>
    </div>

    <section class="writing-hero">
      <div class="writing-hero__pill">
        <span class="writing-hero__dot" aria-hidden="true"></span>
        {entryCount} Entries · Archive
      </div>

      <h1 class="writing-hero__title">Field Notes<span class="writing-hero__period">.</span></h1>

      <p class="writing-hero__lead">
        Dispatches from the slower work of shipping AI systems — the AWS
        plumbing under them and the people side of architecting at the
        C-level.
      </p>

      <div class="writing-hero__tags">
        {tags.map((t) => <span class="writing-hero__tag">{t}</span>)}
      </div>
    </section>

    <section class="archive">
      <div class="archive__grid">
        {
          posts.map((post, i) => (
            <a
              href={`/writing/${post.id}/`}
              class:list={[
                "archive__card",
                i % 2 === 0 ? "archive__card--left" : "archive__card--right",
              ]}
            >
              <div class="archive__meta">
                <span class="archive__tag">{post.data.tag}</span>
                <span class="archive__date">
                  {fmt.format(post.data.date)} · {post.data.readTime}
                </span>
              </div>
              <h3 class="archive__title">{post.data.title}</h3>
              <p class="archive__excerpt">{post.data.excerpt}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page__topnav {
    padding: 24px var(--page-pad-x) 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .page__topnav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .page__topnav a:hover {
    color: var(--accent);
  }

  .writing-hero {
    padding: 56px var(--page-pad-x) 48px;
  }

  .writing-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 32px;
    padding: 5px 12px;
    border: 1px solid var(--accent);
  }

  .writing-hero__dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    display: inline-block;
  }

  .writing-hero__title {
    font-family: var(--font-sans);
    font-weight: 400;
    letter-spacing: -2px;
    margin: 0;
    color: var(--ink);
    line-height: 1.05;
    font-size: 96px;
  }

  .writing-hero__period {
    color: var(--accent);
  }

  .writing-hero__lead {
    font-family: var(--font-sans);
    font-size: 21px;
    line-height: 1.55;
    color: var(--ink2);
    margin: 28px 0 0;
    max-width: 640px;
  }

  .writing-hero__tags {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .writing-hero__tag::after {
    content: " ·";
    color: var(--rule);
    margin-left: 24px;
  }

  .writing-hero__tag:last-child::after {
    content: "";
    margin-left: 0;
  }

  .archive {
    padding: 0 var(--page-pad-x) 64px;
  }

  .archive__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--rule);
  }

  .archive__card {
    display: block;
    padding: 28px 32px 28px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.2s;
  }

  .archive__card--left {
    border-right: 1px solid var(--rule);
    padding-left: 0;
  }

  .archive__card--right {
    padding-left: 32px;
  }

  .archive__card:hover {
    background: var(--bg-alt);
  }

  .archive__meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .archive__tag {
    color: var(--accent);
  }

  .archive__title {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    margin: 0 0 10px;
    letter-spacing: -0.3px;
  }

  .archive__excerpt {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink2);
    font-style: italic;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .writing-hero__title {
      font-size: 72px;
    }
  }

  @media (max-width: 820px) {
    .writing-hero {
      padding: 32px var(--page-pad-x) 32px;
    }
    .writing-hero__title {
      font-size: 52px;
      letter-spacing: -1px;
    }
    .writing-hero__lead {
      font-size: 18px;
    }
    .writing-hero__tags {
      gap: 14px;
    }
    .writing-hero__tag::after {
      margin-left: 14px;
    }

    .archive__grid {
      grid-template-columns: 1fr;
    }
    .archive__card,
    .archive__card--left,
    .archive__card--right {
      border-right: none;
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
