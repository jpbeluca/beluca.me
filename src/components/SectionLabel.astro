---
interface Props {
  n: string;
  title: string;
}

const { n, title } = Astro.props;
---

<div class="section-label">
  <span class="section-label__num">§ {n}.</span>
  <span class="section-label__title">{title}</span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 32px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--rule);
  }

  .section-label__num {
    font-family: var(--font-sans);
    font-style: italic;
    font-size: 22px;
    color: var(--accent);
    line-height: 1;
  }

  .section-label__title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
