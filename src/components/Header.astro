---
import { profile } from "../data/profile";

const navItems = [
  { label: "About", href: "#about" },
  { label: "Work", href: "#work" },
  { label: "Writing", href: "#writing" },
  { label: "Contact", href: "#contact" },
];
---

<header class="site-header">
  <a href="#top" class="brand" aria-label="Beluca.me — home">
    <span class="brand-mark" aria-hidden="true">b</span>
    <span class="brand-word">beluca.me</span>
  </a>

  <nav class="site-nav" aria-label="Primary">
    {
      navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))
    }
    <a class="nav-cta" href={`mailto:${profile.email}`}>Get in touch ↗</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 24px var(--page-pad-x);
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    font-size: 14px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-mark {
    width: 26px;
    height: 26px;
    background: var(--ink);
    color: var(--bg);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    font-style: italic;
    line-height: 1;
  }

  .brand-word {
    font-family: var(--font-sans);
    font-size: 16px;
    letter-spacing: -0.3px;
  }

  .site-nav {
    display: flex;
    align-items: baseline;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .nav-link {
    color: var(--ink2);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .nav-link:hover {
    border-bottom-color: var(--accent);
  }

  .nav-cta {
    color: var(--bg);
    background: var(--ink);
    padding: 6px 14px;
    text-decoration: none;
    font-size: 11px;
    margin-left: 8px;
    transition: background 0.15s;
  }

  .nav-cta:hover {
    background: var(--accent);
  }

  @media (max-width: 820px) {
    .site-header {
      flex-wrap: wrap;
      gap: 16px;
    }
    .site-nav {
      gap: 18px;
      flex-wrap: wrap;
    }
  }
</style>
