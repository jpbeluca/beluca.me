---
import { profile } from "../data/profile";

const rows = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "LinkedIn", value: profile.linkedin, href: profile.linkedinUrl },
  { label: "Location", value: `${profile.location} · open to remote`, href: undefined },
];
---

<section id="contact" class="contact">
  <div class="contact__grid">
    <div class="contact__intro">
      <div class="contact__label">§ VI. Get in touch</div>
      <h2 class="contact__heading">
        <em>Have a system</em><br />worth designing?
      </h2>
      <p class="contact__subhead">
        Open to W2, C2C, or international contractor engagements. Comfortable
        across U.S. time zones.
      </p>
    </div>

    <div class="contact__rows">
      {
        rows.map((row) => (
          <div class="contact-row">
            <span class="contact-row__label">{row.label}</span>
            {row.href ? (
              <a class="contact-row__value" href={row.href}>
                {row.value}
              </a>
            ) : (
              <span class="contact-row__value contact-row__value--static">{row.value}</span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 80px var(--page-pad-x);
    background: var(--ink);
    color: var(--bg);
    border-top: 1px solid var(--rule);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-end;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 24px;
  }

  .contact__heading {
    font-family: var(--font-sans);
    font-size: 60px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: -1px;
    margin: 0;
  }

  .contact__heading em {
    font-style: italic;
  }

  .contact__subhead {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--dark-fg);
    margin-top: 24px;
    max-width: 460px;
    line-height: 1.6;
  }

  .contact__rows {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 2;
  }

  .contact-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    border-bottom: 1px solid var(--dark-rule);
    padding: 8px 0;
    transition: border-color 0.2s;
  }

  .contact-row:hover {
    border-bottom-color: var(--accent);
  }

  .contact-row__label {
    color: var(--dark-label);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .contact-row__value {
    color: var(--bg);
    text-decoration: none;
    border-bottom: 1px dotted transparent;
    transition: border-color 0.2s;
    width: fit-content;
  }

  .contact-row__value:hover {
    border-bottom-color: var(--accent);
  }

  .contact-row__value--static {
    cursor: default;
  }

  @media (max-width: 820px) {
    .contact {
      padding: 64px var(--page-pad-x);
    }
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: flex-start;
    }
    .contact__heading {
      font-size: 44px;
    }
  }
</style>
